# ============================================
# 毕业论文排版系统 - 环境变量配置模板
# ============================================
# 使用方法：
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 修改所有占位符值（特别是密码和密钥）
# 3. 确保 .env 文件不被提交到版本控制（已添加至 .gitignore）
# ============================================

# ============================================
# 数据库配置 (PostgreSQL)
# ============================================

# PostgreSQL 用户名
POSTGRES_USER=thesis_user

# PostgreSQL 密码（生产环境必须使用强密码）
POSTGRES_PASSWORD=your_secure_password_here

# PostgreSQL 数据库名
POSTGRES_DB=thesis_formatter

# PostgreSQL 端口（宿主机映射端口）
POSTGRES_PORT=5432

# 完整的数据库连接 URL（可选，如不设置则自动构建）
# DATABASE_URL=postgresql+asyncpg://thesis_user:password@postgres:5432/thesis_formatter

# ============================================
# Redis 配置
# ============================================

# Redis 密码（生产环境必须使用强密码）
REDIS_PASSWORD=your_redis_password_here

# Redis 端口（宿主机映射端口）
REDIS_PORT=6379

# Redis 连接 URL（可选，如不设置则自动构建）
# REDIS_URL=redis://:password@redis:6379/0

# ============================================
# MinIO 对象存储配置
# ============================================

# MinIO Root 用户名（访问密钥）
MINIO_ROOT_USER=minioadmin

# MinIO Root 密码（秘密密钥，生产环境必须使用强密码）
MINIO_ROOT_PASSWORD=your_minio_secure_password_here

# MinIO API 端口（宿主机映射端口）
MINIO_API_PORT=9000

# MinIO 控制台端口（宿主机映射端口）
MINIO_CONSOLE_PORT=9001

# MinIO 存储桶名称
MINIO_BUCKET_NAME=thesis-files

# MinIO 浏览器重定向 URL（用于控制台访问）
# 如果使用域名，请修改为实际域名
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001

# ============================================
# AI 模型配置
# ============================================

# ------------------------------
# OpenAI 配置
# ------------------------------

# OpenAI API 密钥（从 https://platform.openai.com/api-keys 获取）
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI API 基础 URL（可选，用于代理或 Azure OpenAI）
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenAI 模型名称
# 可选值: gpt-4, gpt-4-turbo-preview, gpt-3.5-turbo
OPENAI_MODEL=gpt-4

# ------------------------------
# DeepSeek 配置
# ------------------------------

# DeepSeek API 密钥（从 https://platform.deepseek.com/ 获取）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# DeepSeek API 基础 URL
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# DeepSeek 模型名称
# 可选值: deepseek-chat, deepseek-coder
DEEPSEEK_MODEL=deepseek-chat

# ------------------------------
# 默认 AI 提供商
# ------------------------------

# 设置默认使用的 AI 提供商
# 可选值: openai, deepseek
DEFAULT_AI_PROVIDER=openai

# ============================================
# 安全配置
# ============================================

# JWT 密钥（用于生成访问令牌，生产环境必须使用强随机密钥）
# 生成命令: openssl rand -hex 32
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# 访问令牌过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 允许的前端来源（CORS），多个来源用逗号分隔
# 示例: https://yourdomain.com,https://app.yourdomain.com
ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://localhost:3000

# ============================================
# 应用配置
# ============================================

# 日志级别
# 可选值: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# 最大上传文件大小（字节）
# 默认 100MB = 104857600 字节
MAX_UPLOAD_SIZE=104857600

# Celery Worker 并发数
# 建议设置为 CPU 核心数
CELERY_CONCURRENCY=4

# ============================================
# 前端配置
# ============================================

# API 基础 URL（前端调用后端的地址）
# 如果前端和后端在同一域名下，使用相对路径 /api
# 如果分开部署，使用完整 URL 如 https://api.yourdomain.com
VITE_API_BASE_URL=/api

# ============================================
# Nginx 配置
# ============================================

# Nginx HTTP 端口（宿主机映射端口）
NGINX_HTTP_PORT=80

# Nginx HTTPS 端口（宿主机映射端口）
NGINX_HTTPS_PORT=443

# ============================================
# 生产环境部署注意事项
# ============================================
#
# 1. 安全性：
#    - 修改所有默认密码和密钥
#    - 使用强密码（至少16位，包含大小写字母、数字、特殊字符）
#    - 定期轮换密钥
#    - 启用 HTTPS（配置 SSL 证书）
#
# 2. 数据库：
#    - 定期备份 PostgreSQL 数据
#    - 考虑使用外部托管数据库（如 AWS RDS、阿里云 RDS）
#
# 3. 存储：
#    - 考虑使用云对象存储（如 AWS S3、阿里云 OSS）替代 MinIO
#    - 定期备份存储桶数据
#
# 4. 监控：
#    - 配置日志收集（如 ELK、Fluentd）
#    - 设置应用监控（如 Prometheus + Grafana）
#    - 配置告警机制
#
# 5. 性能：
#    - 根据实际负载调整资源限制
#    - 考虑使用 CDN 加速静态资源
#    - 配置 Redis 集群提高缓存性能
#
# 6. 高可用：
#    - 部署多个 API 和 Worker 实例
#    - 使用负载均衡器
#    - 配置数据库主从复制
#
# ============================================
